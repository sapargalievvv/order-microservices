# Читается docker compose при подстановке ${...} и pydantic-settings при локальном запуске.
# Скопируй в .env и подставь свои значения.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

USERS_DB_NAME=users_db
ORDERS_DB_NAME=orders_db
PRODUCTS_DB_NAME=products_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# JWT: выпускает user-service, проверяет api-gateway. Больше он не нужен никому.
JWT_SECRET=change-me
JWT_LIFETIME_SECONDS=3600
